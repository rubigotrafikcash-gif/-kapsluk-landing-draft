---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Предпросмотр меню — КАПСЛУК</title>
</head>
<body>
  <main class="phone" aria-label="Макет мобильного меню КАПСЛУК">
    <div class="scene" aria-hidden="true"></div>
    <section class="sheet">
      <header class="top">
        <div class="brand"><img src={`${base}logo.jpeg`} width="34" height="34" alt="" /><span>КАПСЛУК</span></div>
        <a class="close" href={base} aria-label="Закрыть предпросмотр"></a>
      </header>
      <div class="intro">
        <h1>Меню</h1>
      </div>
      <a class="cta" href={`${base}app/`}><span>Создать капсулу</span><span class="arrow" aria-hidden="true"></span></a>
      <nav aria-label="Основные разделы">
        <button type="button"><span>Что будет в PDF</span><span class="arrow" aria-hidden="true"></span></button>
        <button type="button"><span>Как это работает</span><span class="arrow" aria-hidden="true"></span></button>
        <button type="button"><span>Вопросы</span><span class="arrow" aria-hidden="true"></span></button>
        <button type="button"><span>Контакты</span><span class="arrow" aria-hidden="true"></span></button>
      </nav>
      <footer class="bottom">
        <div class="legal">
          <a href={`${base}privacy/`}>Политика обработки персональных данных</a>
          <a href={`${base}terms/`}>Условия использования</a>
        </div>
        <p class="note">Макет мобильного меню</p>
      </footer>
    </section>
  </main>
</body>
</html>
<style>
  *{box-sizing:border-box}
  html,body{margin:0;width:100%;min-height:100%;font-family:Arial,sans-serif;color:#342c25;background:#d5c8b5}
  body{display:grid;place-items:center;overflow:hidden}
  .phone{position:relative;width:min(100%,430px);height:100svh;min-height:620px;overflow:hidden;background:#ece3d5;box-shadow:0 24px 70px #342c2545}
  .scene{position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.6%,#67594b55 49.8%,#67594b55 50.2%,transparent 50.4%),repeating-linear-gradient(90deg,#d7c7b0 0 62px,#b4a38e 63px 65px);filter:blur(2px);transform:scale(1.03)}
  .scene::after{content:"";position:absolute;inset:0;background:#241b148a;backdrop-filter:blur(4px)}
  .sheet{position:absolute;inset:0;background:#f7f2e9;padding:max(18px,env(safe-area-inset-top)) 24px max(24px,env(safe-area-inset-bottom));display:flex;flex-direction:column}
  .top{display:flex;align-items:center;justify-content:space-between}
  .brand{display:flex;align-items:center;gap:10px;font-size:13px;letter-spacing:.17em}
  .brand img{object-fit:cover}
  .close{width:44px;height:44px;position:relative;color:inherit}
  .close::before,.close::after{content:"";position:absolute;left:12px;top:21px;width:21px;height:1px;background:currentColor}
  .close::before{transform:rotate(45deg)}.close::after{transform:rotate(-45deg)}
  .intro{margin:clamp(32px,7svh,60px) 0 18px}
  h1{margin:0;font-family:Georgia,serif;font-size:clamp(40px,12vw,48px);font-weight:400;line-height:1}
  .cta{margin:18px 0 8px;min-height:60px;padding:0 20px;background:#952c29;color:#fff8ef;text-decoration:none;display:flex;align-items:center;justify-content:space-between;font-size:17px}
  .arrow{position:relative;width:25px;height:12px;display:block;flex:0 0 auto}
  .arrow::before{content:"";position:absolute;left:0;right:1px;top:6px;height:1px;background:currentColor}
  .arrow::after{content:"";position:absolute;right:1px;top:2px;width:8px;height:8px;border-top:1px solid currentColor;border-right:1px solid currentColor;transform:rotate(45deg)}
  nav{border-top:1px solid #d7cbbc}
  nav button{width:100%;min-height:59px;padding:0 20px;border:0;border-bottom:1px solid #d7cbbc;background:transparent;display:flex;align-items:center;justify-content:space-between;color:inherit;font:inherit;font-size:17px;text-align:left}
  nav button .arrow{width:19px;color:#8a7865}
  .bottom{margin-top:auto;padding-top:22px}
  .legal{display:flex;flex-direction:column;gap:10px}
  .legal a{color:#706153;font-size:12px;line-height:1.35;text-decoration:underline;text-underline-offset:3px}
  .note{margin:17px 0 0;color:#8a7968;font-size:9px;letter-spacing:.08em;text-transform:uppercase}
  @media(max-height:700px){.intro{margin:18px 0 12px}.cta{margin:13px 0 7px;min-height:54px}nav button{min-height:49px}.bottom{padding-top:14px}.note{display:none}}
</style>
