---
import '../styles/global.css';
import {site} from '../content/site';
import {chapters} from '../scripts/choreography';
import PrivacyContent from '../components/PrivacyContent.astro';
import TermsContent from '../components/TermsContent.astro';
const base = import.meta.env.BASE_URL;
const draft = import.meta.env.PUBLIC_DRAFT !== 'false';
const fusion = import.meta.env.PUBLIC_CONCEPT_FUSION === 'true';
---
<!doctype html>
<html lang="ru" class={fusion ? "fusion-concept" : undefined}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>КАПСЛУК — капсулы и PDF-лукбуки для стилистов</title>
<meta name="description" content="КАПСЛУК помогает стилисту собирать гардеробные капсулы и PDF-лукбуки для клиентов в Telegram." />
{draft && <meta name="robots" content="noindex,nofollow" />}
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
<main id="experience" data-state="closed">
<div id="stage" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>
<section id="welcome" aria-label="Открыть шкаф">
<button id="open-wardrobe" aria-label="Потянуть ручку и открыть шкаф" aria-expanded="false">{!fusion && <span class="handle-cue" aria-hidden="true"></span>}{fusion ? <span class="handle-label">Потяните за ручку</span> : <span class="handle-label">Потяните за ручку<br/><small>или коснитесь</small></span>}</button>
<p id="load-state" class="sr-only" role="status">Подготавливаем гардероб…</p>
</section>
<section id="chapters" aria-label="О боте" inert>
{chapters.map(c=><article class="chapter" aria-hidden="true"><h2>{c.title}</h2></article>)}
</section>
<div class="story-controls" id="story-controls"><button id="pause" hidden>Пауза</button><button id="skip-story">Пропустить</button></div>
<section id="final-screen" aria-labelledby="final-title">
<div class={fusion ? "final-copy fusion-value-copy" : "final-copy"}>
{fusion ? (
  <h2 id="final-title" class="fusion-value-headline" tabindex="-1">
    <span class="fusion-value-lead">Готовый лукбук для клиента</span>
    <span class="fusion-value-time"><span class="fusion-value-prefix">за </span>20 минут</span>
    <span class="fusion-value-compare">вместо двух часов</span>
  </h2>
) : (
  <h2 id="final-title" tabindex="-1">Собирайте капсулы<br class="desktop-break"/> для клиентов в Telegram</h2>
)}
{fusion ? (
  <p class="final-intro fusion-value-support">Вы выбираете вещи и создаёте образы. КАПСЛУК помогает собрать сочетания и оформить PDF-лукбук для клиента в Telegram.</p>
) : (
  <p class="final-intro">Добавляйте выбранные вещи, собирайте сочетания и оформляйте PDF-лукбук для клиента.</p>
)}
<a class="primary" href={fusion ? site.telegramUrl : `${base}app/`} target={fusion ? "_blank" : undefined} rel={fusion ? "noopener noreferrer" : undefined}>{fusion ? "Создать первую капсулу бесплатно" : "Открыть веб-приложение"} <span aria-hidden="true">→</span></a>
{!fusion && <p class="offer-note">Сейчас доступен приватный кликабельный прототип. <a href={site.telegramUrl} target="_blank" rel="noopener noreferrer">Перейти в Telegram ↗</a></p>}
{!fusion && <p class="legal-links"><button type="button" data-dialog="privacy">Политика обработки данных</button><span aria-hidden="true"> · </span><button type="button" data-dialog="terms">Условия использования</button></p>}
</div>
</section>
<header id="top-bar" class="chrome"><a id="brand" href="#welcome" aria-label="КАПСЛУК — начать заново"><img src={`${base}logo.jpeg`} width="36" height="36" alt=""/><span>КАПСЛУК</span></a><button data-dialog="menu">Меню <span aria-hidden="true">＋</span></button></header>
<footer id="bottom-bar" class="chrome"><button id="restart">Повторить путешествие</button></footer>
<p id="story-status" class="sr-only" role="status" aria-live="polite"></p>
</main>
{fusion && <footer id="fusion-footer" class="fusion-footer" aria-label="Информация о КАПСЛУК">
 <div class="fusion-footer-inner">
  <div class="fusion-footer-grid">
   <section class="fusion-footer-section">
    <h2>Бот помогает, стилист решает</h2>
    <p>Вы выбираете предметы одежды, обувь и аксессуары. КАПСЛУК помогает с обработкой изображений, сочетаниями и оформлением PDF-лукбука. Стилистическое решение остаётся за вами.</p>
    <h2>Что происходит с материалами</h2>
    <p>Через 24 часа после успешного создания PDF удаляются исходные изображения и промежуточные рабочие файлы. Итоговый PDF и профиль стилиста сохраняются.</p>
    <a class="fusion-footer-cta" href={site.telegramUrl} target="_blank" rel="noopener noreferrer">Создать первую капсулу бесплатно <span aria-hidden="true">→</span></a>
   </section>
   <section class="fusion-footer-section fusion-footer-faq">
    <h2>Вопросы</h2>
    {site.faq.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}
   </section>
  </div>
  <div class="fusion-footer-bottom">
   <div class="fusion-footer-brand"><img src={`${base}logo.jpeg`} width="42" height="42" alt=""/><span>КАПСЛУК</span></div>
   <nav aria-label="Навигация и контакты" class="fusion-footer-nav">
    <a href={site.telegramUrl} target="_blank" rel="noopener noreferrer">Telegram-бот</a>
    <a href={site.supportUrl} target="_blank" rel="noopener noreferrer">Поддержка в Telegram</a>
    <a href="mailto:support@tairpromo.ru">support@tairpromo.ru</a>
    <button type="button" data-dialog="privacy">Политика конфиденциальности</button>
    <button type="button" data-dialog="terms">Условия использования</button>
   </nav>
  </div>
 </div>
</footer>}
<dialog id="dialog-menu" aria-labelledby="menu-title">
  <div class="menu-top">
    <div class="menu-brand"><img src={`${base}logo.jpeg`} width="34" height="34" alt=""/><span>КАПСЛУК</span></div>
    <button class="close" aria-label="Закрыть">×</button>
  </div>
  <h2 id="menu-title">Меню</h2>
  <a class="menu-cta" href={fusion ? site.telegramUrl : `${base}app/`}><span>Создать капсулу</span><span class="menu-arrow" aria-hidden="true"></span></a>
  <nav aria-label="Основные разделы">
    {site.sections.filter(s=>['result','process','faq'].includes(s.id)).map(s=><button class="menu-link" data-dialog={s.id}><span>{s.label}</span><span class="menu-arrow" aria-hidden="true"></span></button>)}
    <button class="menu-link" data-dialog="contacts"><span>Контакты</span><span class="menu-arrow" aria-hidden="true"></span></button>
  </nav>
  <div class="menu-legal" style={fusion ? "display:none" : undefined}>
    <button type="button" data-dialog="privacy">Политика обработки персональных данных</button>
    <button type="button" data-dialog="terms">Условия использования</button>
  </div>
</dialog>
{site.sections.map(s=><dialog id={`dialog-${s.id}`} aria-labelledby={`title-${s.id}`}><button class="close" aria-label="Закрыть">×</button><h2 id={`title-${s.id}`}>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.id==='faq'&&site.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</dialog>)}
<dialog id="dialog-contacts" aria-labelledby="contacts-title"><button class="close" aria-label="Закрыть">×</button><h2 id="contacts-title">Контакты</h2><p>По вопросам о работе сервиса:</p><div class="contacts-list"><a href={site.supportUrl} target="_blank" rel="noopener noreferrer"><span>Telegram</span><strong>@TairPromo_Support2</strong></a><a href="mailto:support@tairpromo.ru"><span>Электронная почта</span><strong>support@tairpromo.ru</strong></a></div></dialog>
<dialog id="dialog-privacy" class="legal-dialog" aria-labelledby="privacy-title"><button class="close" aria-label="Закрыть">×</button><span id="privacy-title" class="sr-only">Политика обработки персональных данных</span><PrivacyContent /></dialog>
<dialog id="dialog-terms" class="legal-dialog" aria-labelledby="terms-title"><button class="close" aria-label="Закрыть">×</button><span id="terms-title" class="sr-only">Условия использования</span><TermsContent /></dialog>
<noscript><style>#welcome,#stage,.story-controls{display:none!important}#final-screen,.chrome{visibility:visible!important;opacity:1!important;pointer-events:auto!important}#final-screen{background:#f2ece2}body{overflow:auto}</style><div class="no-js">Для анимации шкафа включите JavaScript. Перейти в Telegram можно по кнопке выше.</div></noscript>
<script>import '../scripts/motion';</script>
</body></html>
