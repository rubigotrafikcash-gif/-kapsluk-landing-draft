---
import '../styles/global.css';
import {site} from '../content/site';
import {chapters} from '../scripts/choreography';
const base = import.meta.env.BASE_URL;
const draft = import.meta.env.PUBLIC_DRAFT !== 'false';
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>КАПСЛУК — капсулы и PDF-лукбуки для стилистов</title>
<meta name="description" content="КАПСЛУК помогает стилисту собирать гардеробные капсулы и PDF-лукбуки для клиентов в Telegram." />
{draft && <meta name="robots" content="noindex,nofollow" />}
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
<main id="experience" data-state="closed">
<div id="stage" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>
<section id="welcome" aria-label="Открыть шкаф">
<button id="open-wardrobe" aria-label="Потянуть ручку и открыть шкаф" aria-expanded="false"><span class="handle-cue" aria-hidden="true"></span><span class="handle-label">Потяните за ручку<br/><small>или коснитесь</small></span></button>
<p id="load-state" class="sr-only" role="status">Подготавливаем гардероб…</p>
</section>
<section id="chapters" aria-label="О боте" inert>
{chapters.map(c=><article class="chapter" aria-hidden="true"><h2>{c.title}</h2></article>)}
</section>
<div class="story-controls" id="story-controls"><button id="pause" hidden>Пауза</button><button id="skip-story">Пропустить</button></div>
<section id="final-screen" aria-labelledby="final-title">
<div class="final-copy"><h2 id="final-title" tabindex="-1">Собирайте капсулы<br class="desktop-break"/> для клиентов в Telegram</h2><p class="final-intro">Добавляйте выбранные вещи, собирайте сочетания и оформляйте PDF-лукбук для клиента.</p><a class="primary" href={site.telegramUrl} target="_blank" rel="noopener noreferrer">Открыть бот в Telegram <span aria-hidden="true">↗</span></a><p class="offer-note">В Telegram нажмите «Запустить», чтобы начать диалог.</p></div>
</section>
<header id="top-bar" class="chrome"><a id="brand" href="#welcome" aria-label="КАПСЛУК — начать заново"><img src={`${base}logo.jpeg`} width="36" height="36" alt=""/><span>КАПСЛУК</span></a><button data-dialog="menu">Меню <span aria-hidden="true">＋</span></button></header>
<footer id="bottom-bar" class="chrome"><button id="restart">Повторить путешествие</button></footer>
<p id="story-status" class="sr-only" role="status" aria-live="polite"></p>
</main>
<dialog id="dialog-menu" aria-labelledby="menu-title"><button class="close" aria-label="Закрыть">×</button><p class="eyebrow">КАПСЛУК</p><h2 id="menu-title">Подробнее</h2><nav>{site.sections.map(s=><button data-dialog={s.id}>{s.label}<span aria-hidden="true">↗</span></button>)}</nav></dialog>
{site.sections.map(s=><dialog id={`dialog-${s.id}`} aria-labelledby={`title-${s.id}`}><button class="close" aria-label="Закрыть">×</button><h2 id={`title-${s.id}`}>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.id==='faq'&&site.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</dialog>)}
<noscript><style>#welcome,#stage,.story-controls{display:none!important}#final-screen,.chrome{visibility:visible!important;opacity:1!important;pointer-events:auto!important}#final-screen{background:#f2ece2}body{overflow:auto}</style><div class="no-js">Для анимации шкафа включите JavaScript. Перейти в Telegram можно по кнопке выше.</div></noscript>
<script>import '../scripts/motion';</script>
</body></html>
