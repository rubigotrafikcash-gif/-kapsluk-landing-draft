---
import '../styles/global.css';
import TermsContent from '../components/TermsContent.astro';
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Условия использования — КАПСЛУК</title></head><body class="legal-page"><main><a href={base}>← Вернуться к КАПСЛУК</a><TermsContent /></main></body></html>
<style>.legal-page{overflow:auto;background:#f7f2e9;color:#342c25}.legal-page main{max-width:900px;margin:auto;padding:40px 24px}.legal-page a{text-decoration:underline}.legal-page aside{margin:28px 0;padding:20px;border:1px solid #b59b79}.legal-page p{line-height:1.7;margin:14px 0;overflow-wrap:anywhere}.legal-page h1{font-size:2rem;margin:28px 0}.legal-page h2{font-size:1.3rem;margin:30px 0 14px}</style>
