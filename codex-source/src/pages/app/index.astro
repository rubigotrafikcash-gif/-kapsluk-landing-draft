---
import '../../styles/app.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#f4efe7" />
  <title>КАПСЛУК — собрать капсулу</title>
  <meta name="description" content="Мобильное приложение КАПСЛУК для добавления вещей и подготовки PDF-лукбука." />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <button class="icon-button" id="back-button" type="button" aria-label="Вернуться назад" hidden>
        <span aria-hidden="true">←</span>
      </button>
      <a class="app-brand" href={base} aria-label="КАПСЛУК — на главную">
        <img src={`${base}logo.jpeg`} width="32" height="32" alt="" />
        <span>КАПСЛУК</span>
      </a>
      <button class="icon-button" id="help-button" type="button" aria-label="Открыть справку">
        <span aria-hidden="true">?</span>
      </button>
    </header>

    <main id="app" aria-live="polite">
      <section class="screen screen--intro is-active" data-screen="intro" aria-labelledby="intro-title">
        <div class="intro-art" aria-hidden="true">
          <div class="paper paper--back"></div>
          <div class="paper paper--front">
            <span class="garment garment--one"></span>
            <span class="garment garment--two"></span>
            <span class="garment garment--three"></span>
            <span class="look-line"></span>
            <span class="look-line look-line--short"></span>
          </div>
        </div>
        <p class="status-pill"><span></span> Приватный прототип</p>
        <h1 id="intro-title" tabindex="-1">Соберите капсулу<br />по понятным шагам</h1>
        <p class="lead">Добавляйте вещи по одной, проверяйте каждую и подготовьте материалы для PDF-лукбука.</p>
        <ul class="benefits" aria-label="Возможности приложения">
          <li><span>01</span><p>До 12 вещей, включая обувь и аксессуары</p></li>
          <li><span>02</span><p>Любой порядок и несколько вещей одной категории</p></li>
          <li><span>03</span><p>Подтверждение каждой вещи перед созданием PDF</p></li>
        </ul>
        <button class="button button--primary button--wide" type="button" data-next="consent">Создать капсулу <span aria-hidden="true">→</span></button>
        <p class="microcopy">В этой версии материалы остаются только в памяти браузера и исчезают после перезагрузки.</p>
      </section>

      <section class="screen" data-screen="consent" aria-labelledby="consent-title" hidden>
        <p class="step-label">Шаг 1 из 2</p>
        <h1 id="consent-title" tabindex="-1">Перед началом</h1>
        <p class="lead lead--left">Примите условия сервиса и отдельно дайте согласие на обработку персональных данных.</p>
        <form id="consent-form" novalidate>
          <fieldset class="choice-list">
            <legend class="sr-only">Документы и согласие</legend>
            <label class="choice-card">
              <input id="terms-agree" name="terms" type="checkbox" required />
              <span class="checkmark" aria-hidden="true"></span>
              <span>Принимаю <a href={`${base}terms/`} target="_blank" rel="noopener">Условия использования</a></span>
            </label>
            <label class="choice-card">
              <input id="data-agree" name="personal-data" type="checkbox" required />
              <span class="checkmark" aria-hidden="true"></span>
              <span>Даю <a href={`${base}consent/`} target="_blank" rel="noopener">согласие на обработку персональных данных</a> и ознакомлен(а) с <a href={`${base}privacy/`} target="_blank" rel="noopener">Политикой</a></span>
            </label>
          </fieldset>
          <p class="form-error" id="consent-error" role="alert" hidden>Отметьте оба пункта, чтобы продолжить.</p>
          <button class="button button--primary button--wide" type="submit">Продолжить <span aria-hidden="true">→</span></button>
        </form>
        <div class="privacy-note">
          <span aria-hidden="true">⌁</span>
          <p><strong>Без лишних данных.</strong> Не загружайте фотографии людей, документы и ФИО клиента.</p>
        </div>
      </section>

      <section class="screen" data-screen="setup" aria-labelledby="setup-title" hidden>
        <p class="step-label">Шаг 2 из 2</p>
        <h1 id="setup-title" tabindex="-1">Назовите капсулу</h1>
        <p class="lead lead--left">Название увидите только вы. Используйте нейтральное обозначение без имени клиента.</p>
        <form id="setup-form" class="stack" novalidate>
          <label class="field">
            <span>Название капсулы</span>
            <input id="capsule-name" name="capsule-name" type="text" maxlength="60" autocomplete="off" placeholder="Например, «Осень · проект 07»" required />
            <small>До 60 символов. Не указывайте ФИО, телефон или email.</small>
          </label>
          <p class="form-error" id="setup-error" role="alert" hidden>Введите нейтральное название капсулы.</p>
          <button class="button button--primary button--wide" type="submit">Создать капсулу <span aria-hidden="true">→</span></button>
        </form>
      </section>

      <section class="screen screen--workspace" data-screen="workspace" aria-labelledby="workspace-title" hidden>
        <div class="workspace-heading">
          <div>
            <p class="step-label">Текущая капсула</p>
            <h1 id="workspace-title" tabindex="-1">Новая капсула</h1>
          </div>
          <div class="counter" aria-label="Количество вещей"><strong id="item-count">0</strong><span>/12</span></div>
        </div>

        <div class="progress" aria-hidden="true"><span id="progress-fill"></span></div>

        <div id="empty-state" class="empty-state">
          <div class="empty-closet" aria-hidden="true"><span></span><span></span><i></i></div>
          <h2>Добавьте первую вещь</h2>
          <p>Укажите категорию, короткий комментарий и ссылку на товар. Скриншот можно приложить сразу.</p>
        </div>

        <div id="items-region" hidden>
          <div class="section-title"><h2>Вещи в капсуле</h2><span id="items-summary">0 подтверждено</span></div>
          <ol id="items-list" class="items-list"></ol>
        </div>

        <div class="workspace-actions">
          <button class="button button--secondary button--wide" id="add-item" type="button">Добавить вещь <span aria-hidden="true">＋</span></button>
          <button class="button button--primary button--wide" id="prepare-pdf" type="button" disabled>Проверить готовность PDF <span aria-hidden="true">→</span></button>
        </div>
      </section>

      <section class="screen" data-screen="item" aria-labelledby="item-title" hidden>
        <p class="step-label">Новая вещь · <span id="next-item-number">1</span> из 12</p>
        <h1 id="item-title" tabindex="-1">Добавьте вещь</h1>
        <p class="lead lead--left">Сначала заполним данные. Затем вы проверите карточку перед добавлением.</p>
        <form id="item-form" class="stack" novalidate>
          <label class="upload" id="upload-label">
            <input id="item-image" name="image" type="file" accept="image/jpeg,image/png,image/webp" />
            <span class="upload-icon" aria-hidden="true">＋</span>
            <span class="upload-copy"><strong>Добавить скриншот</strong><small>Необязательно · JPG, PNG или WEBP</small></span>
            <img id="upload-preview" alt="Предпросмотр выбранного изображения" hidden />
          </label>

          <label class="field">
            <span>Категория</span>
            <select id="item-category" name="category" required>
              <option value="">Выберите категорию</option>
              <option>Верх</option><option>Низ</option><option>Платье</option><option>Верхняя одежда</option>
              <option>Обувь</option><option>Сумка</option><option>Аксессуар</option><option>Другое</option>
            </select>
          </label>

          <label class="field">
            <span>Комментарий стилиста</span>
            <textarea id="item-comment" name="comment" maxlength="240" rows="3" placeholder="Например: базовый верх для повседневных образов" required></textarea>
            <small><span id="comment-count">0</span>/240</small>
          </label>

          <label class="field">
            <span>Ссылка на товар</span>
            <input id="item-url" name="url" type="url" inputmode="url" autocomplete="url" placeholder="https://…" required />
            <small>Ссылка будет кликабельной в готовом PDF.</small>
          </label>

          <p class="form-error" id="item-error" role="alert" hidden>Заполните категорию, комментарий и корректную ссылку.</p>
          <button class="button button--primary button--wide" type="submit">Проверить вещь <span aria-hidden="true">→</span></button>
        </form>
      </section>

      <section class="screen" data-screen="review" aria-labelledby="review-title" hidden>
        <p class="step-label">Проверка вещи</p>
        <h1 id="review-title" tabindex="-1">Всё верно?</h1>
        <p class="lead lead--left">В рабочей версии здесь появится обработанное изображение. В прототипе показываем исходный скриншот.</p>

        <article class="review-card">
          <div class="review-image" id="review-image"><span>Изображение<br />из ссылки</span></div>
          <div class="review-content">
            <p class="review-category" id="review-category">Категория</p>
            <p id="review-comment">Комментарий</p>
            <a id="review-url" href="#" target="_blank" rel="noopener">Открыть товар ↗</a>
          </div>
        </article>

        <div class="review-note"><span aria-hidden="true">✓</span><p>Подтверждая вещь, вы включаете её в будущую капсулу.</p></div>
        <div class="button-row">
          <button class="button button--secondary" id="edit-item" type="button">Исправить</button>
          <button class="button button--primary" id="confirm-item" type="button">Подтвердить</button>
        </div>
      </section>

      <section class="screen" data-screen="ready" aria-labelledby="ready-title" hidden>
        <div class="success-mark" aria-hidden="true">✓</div>
        <p class="step-label">Капсула собрана</p>
        <h1 id="ready-title" tabindex="-1">Материалы готовы<br />к созданию PDF</h1>
        <p class="lead" id="ready-summary">Все вещи подтверждены.</p>
        <div class="prototype-card">
          <p class="prototype-label">Что работает сейчас</p>
          <h2>Интерфейс и проверка сценария</h2>
          <p>Прототип не загружает материалы на сервер и не создаёт PDF. Для этого подключим российский backend после настройки хранения и удаления файлов.</p>
        </div>
        <button class="button button--primary button--wide" id="return-workspace" type="button">Вернуться к капсуле</button>
        <a class="text-link" href="https://t.me/TairPromo_Support2" target="_blank" rel="noopener noreferrer">Сообщить о проблеме в Telegram</a>
      </section>
    </main>

    <footer class="app-footer">
      <a href={`${base}privacy/`}>Политика</a>
      <a href={`${base}terms/`}>Условия</a>
      <a href="https://t.me/TairPromo_Support2" target="_blank" rel="noopener noreferrer">Поддержка</a>
    </footer>
  </div>

  <dialog id="help-dialog" aria-labelledby="help-title">
    <button class="dialog-close" type="button" aria-label="Закрыть справку">×</button>
    <p class="step-label">Помощь</p>
    <h2 id="help-title">Как работает прототип</h2>
    <ol>
      <li>Создайте капсулу без имени клиента.</li>
      <li>Добавьте до 12 вещей в любом порядке.</li>
      <li>Проверьте и подтвердите каждую карточку.</li>
    </ol>
    <p>Данные не отправляются на сервер и исчезают после перезагрузки страницы.</p>
    <a class="button button--secondary button--wide" href="https://t.me/TairPromo_Support2" target="_blank" rel="noopener noreferrer">Написать в Telegram</a>
  </dialog>

  <dialog id="delete-dialog" aria-labelledby="delete-title">
    <p class="step-label">Удаление</p>
    <h2 id="delete-title">Удалить вещь?</h2>
    <p>Карточка исчезнет из текущего черновика.</p>
    <div class="button-row">
      <button class="button button--secondary" id="cancel-delete" type="button">Оставить</button>
      <button class="button button--danger" id="confirm-delete" type="button">Удалить</button>
    </div>
  </dialog>

  <noscript><div class="noscript">Для работы приложения включите JavaScript.</div></noscript>
  <script>import '../../scripts/app';</script>
</body>
</html>
